# Live Recorder configuration. Copy to `.env` and adjust as needed.
# Every key below matches a field in app/config.py; unset keys use the defaults.

# --- App --------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Capture (CAPTURE_ prefix) ----------------------------------------------
# frame_size and target_sample_rate are the single source of truth for the VAD
# and the streaming resampler. Do not hardcode these values elsewhere.
CAPTURE_FRAME_SIZE=512
CAPTURE_TARGET_SAMPLE_RATE=16000
CAPTURE_CHUNK_FRAMES=1024
# Speaker labels: mic -> left channel, loopback -> right channel.
CAPTURE_MIC_LABEL=Я
CAPTURE_LOOPBACK_LABEL=Собеседники
CAPTURE_NEUTRAL_LABEL=Speaker

# --- STT (STT_ prefix) ------------------------------------------------------
STT_ENGINE=gigaam
# gigaam_revision: "e2e_rnnt" | "e2e_ctc"
STT_GIGAAM_MODEL_ID=ai-sage/GigaAM-v3
STT_GIGAAM_REVISION=e2e_rnnt
# device: "auto" (cuda if available else cpu) | "cpu" | "cuda:0"
STT_DEVICE=auto

# --- VAD (VAD_ prefix) ------------------------------------------------------
VAD_THRESHOLD=0.5
VAD_SILENCE_TIMEOUT=0.8
VAD_MAX_DURATION=60

# --- Session (SESSION_ prefix) ----------------------------------------------
# mode: "live" | "batch" | "file"
SESSION_MODE=live
SESSION_OUTPUT_DIR=recordings

# --- LLM summarization (LLM_ prefix) ----------------------------------------
# On-demand meeting summarization via an OpenAI-compatible endpoint.
# LLM_URL is used as the openai client base_url (include /v1 if required).
LLM_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
# Map-reduce tunables (chunk sizes are in CHARACTERS, not tokens).
LLM_CHUNK_CHARS=8000
LLM_CHUNK_OVERLAP=400
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=16384
# Per-request timeout in seconds.
LLM_REQUEST_TIMEOUT=120
